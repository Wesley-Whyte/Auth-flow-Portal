@model authflow.Portal.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-5">
    <div class="col-sm-10 col-md-7 col-lg-5 col-xl-4">

        @if (TempData["SuccessMessage"] is string msg)
        {
            <div class="alert alert-success py-2 small text-center mb-3" role="alert">@msg</div>
        }

        <div class="card shadow-sm">
            <div class="card-body p-4 p-sm-5">

                <h1 class="h4 fw-semibold text-center mb-1">Welcome back</h1>
                <p class="text-muted text-center mb-4 small">Sign in to your account</p>

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label"></label>
                        <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <label asp-for="Password" class="form-label"></label>
                            <a href="#" class="small text-decoration-none">Forgot password?</a>
                        </div>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Sign in</button>

                    <p class="text-center mt-3 mb-0 small">
                        Don't have an account?
                        <a asp-action="Register" asp-controller="Auth" class="text-decoration-none">Create one</a>
                    </p>

                </form>

                <div class="d-flex align-items-center my-4 gap-2">
                    <hr class="flex-grow-1 m-0" />
                    <span class="text-muted small">or</span>
                    <hr class="flex-grow-1 m-0" />
                </div>

                <a asp-controller="EntraAuth" asp-action="SignIn"
                   asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]"
                   class="btn btn-outline-secondary w-100">
                    Sign in with Microsoft
                </a>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
